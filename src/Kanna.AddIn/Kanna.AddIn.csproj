<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Kanna</AssemblyName>
    <RootNamespace>Kanna.AddIn</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Kanna for VBA</Product>
    <Description>VBE (Visual Basic Editor) 用の軽量コード整形アドイン</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 整形エンジンは同じ DLL に含める（Office プロセスからの依存 DLL 解決を避けるため） -->
    <Compile Include="..\Kanna.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!--
    Office の相互運用アセンブリ（Microsoft.Vbe.Interop / office）は、Microsoft の配布物なのでリポジトリに含めない。
    ビルド時は Office をインストールした環境の GAC から参照する。
    GAC にない場合は、DLL を置いたフォルダーを指定してビルドする:
      dotnet build -p:OfficeInteropDir=C:\path\to\dlls
    相互運用型は DLL に埋め込む（EmbedInteropTypes）ので、実行時には不要。
  -->
  <PropertyGroup>
    <_GacMsil>$(WINDIR)\assembly\GAC_MSIL</_GacMsil>
  </PropertyGroup>

  <ItemGroup Condition="'$(OfficeInteropDir)' != ''">
    <_VbeInterop Include="$(OfficeInteropDir)\Microsoft.Vbe.Interop.dll" Condition="Exists('$(OfficeInteropDir)\Microsoft.Vbe.Interop.dll')" />
    <_OfficeInterop Include="$(OfficeInteropDir)\office.dll" Condition="Exists('$(OfficeInteropDir)\office.dll')" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfficeInteropDir)' == ''">
    <_VbeInterop Include="$(_GacMsil)\Microsoft.Vbe.Interop\*\Microsoft.Vbe.Interop.dll" />
    <_OfficeInterop Include="$(_GacMsil)\office\*\office.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="@(_VbeInterop);@(_OfficeInterop)">
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckOfficeInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'@(_VbeInterop)' == '' Or '@(_OfficeInterop)' == ''"
           Text="Office の相互運用アセンブリ（Microsoft.Vbe.Interop.dll / office.dll）が見つかりません。Office をインストールするか、-p:OfficeInteropDir=&lt;DLL のあるフォルダー&gt; を指定してください。" />
    <Warning Condition="@(_VbeInterop->Count()) &gt; 1 Or @(_OfficeInterop->Count()) &gt; 1"
             Text="GAC に複数バージョンの相互運用アセンブリがあります。ビルドに失敗する場合は -p:OfficeInteropDir で 1 つを指定してください。" />
  </Target>

</Project>
